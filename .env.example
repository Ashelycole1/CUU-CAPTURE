# ---- VisaDesk environment (copy to .env.local for development) ----
APP_NAME=VisaDesk
NEXT_PUBLIC_APP_NAME=VisaDesk
# Public base URL (used in emails and the CSRF origin check)
APP_URL=http://localhost:3000

# Database: libSQL. Local/tests use a plain SQLite file; production uses Turso.
DATABASE_URL=file:./data/visadesk.db
# Turso auth token (production only; leave empty for file: URLs)
DATABASE_AUTH_TOKEN=
# Local data directory (blobs for LocalDiskStore in dev; never used in prod)
DATA_DIR=./data

# Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET=change-me-dev-session-secret-at-least-32-chars
# 32 bytes, base64. All stored files are AES-256-GCM encrypted with this key.
FILE_ENCRYPTION_KEY=
# Key id written into each encrypted file header (bump when rotating keys)
FILE_ENCRYPTION_KEY_ID=k1
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*
CRON_SECRET=change-me-dev-cron-secret

# Storage: Vercel Blob in production (BLOB_READ_WRITE_TOKEN present => VercelBlobStore)
BLOB_READ_WRITE_TOKEN=

# Email: Resend in production (RESEND_API_KEY present => ResendChannel, else DevOutbox)
RESEND_API_KEY=
EMAIL_FROM="VisaDesk <no-reply@visadesk.example>"

# Comma-separated domains allowed to self-register as students
ALLOWED_EMAIL_DOMAINS=cavendish.ac.ug
DEFAULT_TIMEZONE=Africa/Kampala

# ---- Jobs / infra (optional) ----
# Resend webhook signing secret (whsec_...) for /api/webhooks/resend (bounces -> "student unreachable")
RESEND_WEBHOOK_SECRET=
# Max notification emails the cron sends per rolling 24 h (Resend free tier = 100/day incl. OTP codes)
EMAIL_DAILY_CAP=80
# Cron time budget in ms before a run saves its cursor and continues in a new invocation
CRON_BUDGET_MS=40000
# Retired file keys still needed to READ old files during a key rotation: "k1:<base64>,k2:<base64>"
FILE_ENCRYPTION_PREVIOUS_KEYS=
